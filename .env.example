# ─── Offerteformulier — SMTP-instellingen ────────────────────────────────────
# Kopieer dit bestand naar `.env.local` en vul je eigen gegevens in.
# `.env.local` staat in .gitignore en wordt NOOIT gecommit.
#
# Deze waarden komen van je e-mailhosting (de MTB-mailbox). Vraag ze op bij je
# hostingprovider of vind ze in je mailclient-instellingen (IMAP/SMTP).

# SMTP-server van je e-mailhosting (bijv. smtp.jouwprovider.nl)
SMTP_HOST=

# Poort: 587 (STARTTLS, meest gangbaar) of 465 (SSL/TLS)
SMTP_PORT=587

# Laat leeg om automatisch te kiezen (true bij poort 465, anders false).
# Forceer met "true" of "false" indien nodig.
SMTP_SECURE=

# Inloggegevens van de mailbox waarmee verstuurd wordt
SMTP_USER=
SMTP_PASS=

# Afzender-adres (meestal gelijk aan SMTP_USER). Moet bij je domein horen voor
# goede aflevering (SPF/DKIM).
OFFERTE_FROM_EMAIL=

# Naar welk adres de offerte-aanvragen worden gestuurd (jouw inbox)
OFFERTE_TO_EMAIL=
