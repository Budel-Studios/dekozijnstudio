# ─── Formulieren — e-mail ─────────────────────────────────────────────────────
# Kopieer dit bestand naar `.env.local` (lokaal) of zet de waarden in Vercel →
# Settings → Environment Variables. `.env.local` wordt NOOIT gecommit.
#
# Aanvragen gaan voorlopig naar de mailbox van MTB Bouw (info@mtbbouw.com).

# Aanbevolen: dezelfde Resend-sleutel als op de MTB Bouw-website.
# Het domein mtbbouw.com is daar al als afzender ingesteld.
RESEND_API_KEY=
# Afzender (moet bij een in Resend geverifieerd domein horen)
MAIL_FROM=website@mtbbouw.com

# Optioneel: ander ontvangstadres dan info@mtbbouw.com
OFFERTE_TO_EMAIL=

# ─── Alternatief: SMTP (alleen gebruikt als RESEND_API_KEY leeg is) ──────────
SMTP_HOST=
# 587 (STARTTLS) of 465 (SSL/TLS)
SMTP_PORT=587
# Leeg = automatisch (true bij 465)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
OFFERTE_FROM_EMAIL=

# Productie-URL (Vercel). Standaard https://www.kozijnstudio.com
NEXT_PUBLIC_SITE_URL=
